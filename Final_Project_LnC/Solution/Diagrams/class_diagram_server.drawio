<mxfile host="app.diagrams.net" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/137.0.0.0 Safari/537.36 Edg/137.0.0.0" version="27.1.6">
  <diagram name="Page-1" id="-b9JF_TPrE4qvKp1WXRp">
    <mxGraphModel dx="5836" dy="3412" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\n&#39; === Adapters ===\ninterface INewsApiAdapter {\n    +fetchArticles() : json\n    +getSourceName() : string\n}\nclass TheNewsApiAdapter {\n    +fetchArticles() : json\n    +getSourceName() : string\n}\nINewsApiAdapter &lt;|-- TheNewsApiAdapter\nclass NewsApiOrgAdapter {\n    +fetchArticles() : json\n    +getSourceName() : string\n}\nINewsApiAdapter &lt;|-- NewsApiOrgAdapter\n\n&#39; === Managers ===\nclass NewsFetcherManager {\n    +registerAdapter(adapter : shared_ptr&lt;INewsApiAdapter&gt;)\n    +fetchAll()\n    -adapters : vector&lt;shared_ptr&lt;INewsApiAdapter&gt;&gt;\n}\nNewsFetcherManager o-- INewsApiAdapter\n\n&#39; === Services ===\nclass ArticleService {\n    +getAllArticles() : json\n    +getArticleById(articleId : int) : json\n    +getArticlesByCategory(category : string) : json\n    +saveArticle(userId : int, articleId : int)\n    +deleteSavedArticle(userId : int, articleId : int)\n    +getSavedArticlesForUser(userId : int) : json\n    +likeArticle(userId : int, articleId : int)\n    +dislikeArticle(userId : int, articleId : int)\n    +getReactionStats(articleId : int) : json\n    +searchArticles(keyword : string, startDate : string, endDate : string, sortBy : string) : json\n    +storeArticle(article : json)\n}\nclass NotificationService {\n    +setCategoryPreference(userId : int, category : string, isEnabled : bool)\n    +setKeywordPreference(userId : int, keyword : string, isEnabled : bool)\n    +getUserPreferences(userId : int) : json\n    +getDeliveredNotifications(userId : int) : json\n}\nclass AdminService {\n    +listExternalServers() : json\n    +viewExternalServerDetails(serverId : int) : json\n    +updateExternalServerApiKey(serverId : int, newKey : string) : bool\n    +updateExternalServerStatus(serverId : int, newStatus : string) : bool\n    +updateExternalServerStatus(serverName : string, status : string) : bool\n    +addCategory(category : string) : bool\n}\nclass UserService {\n    +login(email : string, password : string, userId : int&amp;, role : string&amp;) : bool\n    +signup(username : string, email : string, password : string) : bool\n    +getUserIdByEmail(email : string) : int\n}\n\n&#39; === Database ===\nclass Database {\n    +getAllArticles() : json\n    +getArticlesByCategory(category : string) : json\n    +getArticleById(id : int) : json\n    +saveArticleForUser(userId : int, articleId : int)\n    +getSavedArticlesForUser(userId : int) : json\n    +deleteSavedArticle(userId : int, articleId : int)\n    +likeArticle(userId : int, articleId : int)\n    +dislikeArticle(userId : int, articleId : int)\n    +searchArticles(keyword : string, startDate : string, endDate : string, sortBy : string) : json\n    +getReactionStats(articleId : int) : json\n    +addCategory(category : string)\n    +getCategoryId(category : string) : int\n    +setCategoryNotificationPreference(userId : int, categoryId : int, isEnabled : bool)\n    +setKeywordNotificationPreference(userId : int, keyword : string, isEnabled : bool)\n    +getUserNotificationPreferences(userId : int) : json\n    +addNotificationsForCategory(userId : int, category : string)\n    +filterNotificationsByKeyword(userId : int, keyword : string)\n    +getDeliveredNotifications(userId : int) : json\n    +getUnreadNotifications(userId : int) : json\n    +insertNotification(userId : int, articleId : int, title : string, message : string)\n    +markNotificationsAsRead(userId : int)\n    +notifyUsersIfMatched(title : string, content : string, category : string, articleId : int)\n    +getAllExternalServers() : json\n    +getExternalServerById(serverId : int) : json\n    +updateExternalServerApiKey(serverId : int, newApiKey : string)\n    +updateExternalServerStatus(serverId : int, status : string)\n    +updateExternalServerStatusByName(serverName : string, status : string)\n    +getUserIdByEmail(email : string) : int\n    +authenticateUser(email : string, password : string, userId : int&amp;, role : string&amp;) : bool\n    +registerUser(username : string, email : string, password : string) : bool\n    +createDefaultAdmin()\n    +storeArticle(article : json)\n}\nclass DBManager {\n    +getInstance() : DBManager&amp;\n    +~DBManager()\n    +initializeDB(dbPath : string) : bool\n    +getDB() : sqlite3*\n    +close()\n    -executeSchema() : bool\n    -db : sqlite3*\n}\n\n&#39; === Routes ===\nclass RouteManager {\n    +setupRoutes(router : Pistache::Rest::Router&amp;)\n}\n\n&#39; === Scheduler ===\nclass FetchScheduler {\n    +FetchScheduler()\n    +~FetchScheduler()\n    +start()\n    +stop()\n    -schedulerThread : thread\n    -running : atomic&lt;bool&gt;\n    -mtx : mutex\n    -cv : condition_variable\n    -run()\n    -fetchAndStoreArticles()\n}\n\n&#39; === Utils ===\nclass HttpClient {\n    +get(url : string) : string\n}\nclass CategoryClassifier {\n    +classify(title : string, content : string) : string\n}\nclass EmailSender {\n    +sendNotifications(userId : int, articles : json)\n    -sendEmail(to : string, subject : string, body : string) : bool\n}\nclass Strings\n\n&#39; === Cross-folder Relationships ===\n&#39; Services use Database\nArticleService ..&gt; Database : uses\nNotificationService ..&gt; Database : uses\nAdminService ..&gt; Database : uses\nUserService ..&gt; Database : uses\n\n&#39; Services may use Managers/Adapters (e.g., for fetching news)\nArticleService ..&gt; NewsFetcherManager : uses\nNewsFetcherManager o-- INewsApiAdapter\n\n&#39; Adapters use Utils (e.g., HttpClient)\nTheNewsApiAdapter ..&gt; HttpClient : uses\nNewsApiOrgAdapter ..&gt; HttpClient : uses\n\n&#39; Managers may use Utils\nNewsFetcherManager ..&gt; CategoryClassifier : uses\n\n&#39; Routes use Services\nRouteManager ..&gt; ArticleService : uses\nRouteManager ..&gt; NotificationService : uses\nRouteManager ..&gt; AdminService : uses\nRouteManager ..&gt; UserService : uses\n\n&#39; Scheduler uses Managers/Services\nFetchScheduler ..&gt; NewsFetcherManager : uses\nFetchScheduler ..&gt; ArticleService : uses\n\n&#39; Database uses DBManager\nDatabase ..&gt; DBManager : uses\n\n&#39; Utils used by many\nEmailSender ..&gt; Strings : uses\nTheNewsApiAdapter ..&gt; Strings : uses\nNewsApiOrgAdapter ..&gt; Strings : uses\n\n@enduml &quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="wY4zhqpP4Ofpt6DV_sy1-2">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1">
            <mxGeometry x="-990" y="-480" width="2804" height="1607" as="geometry" />
          </mxCell>
        </UserObject>
      </root>
    </mxGraphModel>
  </diagram>
