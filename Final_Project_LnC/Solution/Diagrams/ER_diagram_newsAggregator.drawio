      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nentity \&quot;user_role\&quot; as user_role {\n  * id : INTEGER &lt;&lt;PK&gt;&gt;\n  --\n  type : TEXT &lt;&lt;UNIQUE&gt;&gt;\n}\n\nentity \&quot;user\&quot; as user {\n  * id : INTEGER &lt;&lt;PK&gt;&gt;\n  --\n  username : TEXT &lt;&lt;UNIQUE&gt;&gt;\n  email : TEXT &lt;&lt;UNIQUE&gt;&gt;\n  password : TEXT\n  role_id : INTEGER &lt;&lt;FK&gt;&gt;\n  notification_viewed_at : DATETIME\n}\n\nentity \&quot;server_status\&quot; as server_status {\n  * id : INTEGER &lt;&lt;PK&gt;&gt;\n  --\n  type : TEXT &lt;&lt;UNIQUE&gt;&gt;\n}\n\nentity \&quot;external_server\&quot; as external_server {\n  * id : INTEGER &lt;&lt;PK&gt;&gt;\n  --\n  server_name : TEXT\n  api_url : TEXT\n  api_key : TEXT\n  server_status_id : INTEGER &lt;&lt;FK&gt;&gt;\n  last_accessed : DATETIME\n}\n\nentity \&quot;news_article\&quot; as news_article {\n  * id : INTEGER &lt;&lt;PK&gt;&gt;\n  --\n  uuid : TEXT\n  title : TEXT\n  description : TEXT\n  category : TEXT\n  language : TEXT\n  created_at : DATETIME\n  locale : TEXT\n  url : TEXT &lt;&lt;UNIQUE&gt;&gt;\n  image_url : TEXT\n  content : TEXT\n  source : TEXT\n}\n\nentity \&quot;news_category\&quot; as news_category {\n  * id : INTEGER &lt;&lt;PK&gt;&gt;\n  --\n  category_type : TEXT &lt;&lt;UNIQUE&gt;&gt;\n}\n\nentity \&quot;news_article_category\&quot; as news_article_category {\n  * id : INTEGER &lt;&lt;PK&gt;&gt;\n  --\n  news_id : INTEGER &lt;&lt;FK&gt;&gt;\n  category_id : INTEGER &lt;&lt;FK&gt;&gt;\n  created_at : DATETIME\n}\n\nentity \&quot;saved_news\&quot; as saved_news {\n  * id : INTEGER &lt;&lt;PK&gt;&gt;\n  --\n  news_id : INTEGER &lt;&lt;FK&gt;&gt;\n  user_id : INTEGER &lt;&lt;FK&gt;&gt;\n  saved_at : DATETIME\n}\n\nentity \&quot;news_article_reaction\&quot; as news_article_reaction {\n  * id : INTEGER &lt;&lt;PK&gt;&gt;\n  --\n  user_id : INTEGER &lt;&lt;FK&gt;&gt;\n  news_id : INTEGER &lt;&lt;FK&gt;&gt;\n  reaction_type : TEXT\n  reacted_at : DATETIME\n}\n\nentity \&quot;notification_keyword_pref\&quot; as notification_keyword_pref {\n  * id : INTEGER &lt;&lt;PK&gt;&gt;\n  --\n  user_id : INTEGER &lt;&lt;FK&gt;&gt;\n  keyword : TEXT\n  is_enabled : INTEGER\n  created_at : DATETIME\n}\n\nentity \&quot;notification_category_pref\&quot; as notification_category_pref {\n  * id : INTEGER &lt;&lt;PK&gt;&gt;\n  --\n  user_id : INTEGER &lt;&lt;FK&gt;&gt;\n  category_id : INTEGER &lt;&lt;FK&gt;&gt;\n  is_enabled : INTEGER\n  created_at : DATETIME\n}\n\nentity \&quot;notifications\&quot; as notifications {\n  * id : INTEGER &lt;&lt;PK&gt;&gt;\n  --\n  user_id : INTEGER &lt;&lt;FK&gt;&gt;\n  article_id : INTEGER &lt;&lt;FK&gt;&gt;\n  title : TEXT\n  message : TEXT\n  timestamp : TEXT\n  read : INTEGER\n}\n\n&#39; Relationships\nuser_role ||--o{ user : \&quot;role_id\&quot;\nserver_status ||--o{ external_server : \&quot;server_status_id\&quot;\nuser ||--o{ saved_news : \&quot;user_id\&quot;\nnews_article ||--o{ saved_news : \&quot;news_id\&quot;\nuser ||--o{ news_article_reaction : \&quot;user_id\&quot;\nnews_article ||--o{ news_article_reaction : \&quot;news_id\&quot;\nnews_article ||--o{ news_article_category : \&quot;news_id\&quot;\nnews_category ||--o{ news_article_category : \&quot;category_id\&quot;\nuser ||--o{ notification_keyword_pref : \&quot;user_id\&quot;\nuser ||--o{ notification_category_pref : \&quot;user_id\&quot;\nnews_category ||--o{ notification_category_pref : \&quot;category_id\&quot;\nuser ||--o{ notifications : \&quot;user_id\&quot;\nnews_article ||--o{ notifications : \&quot;article_id\&quot;\n\n@enduml&quot;,&#xa;  &quot;format&quot;: &quot;svg&quot;&#xa;}" id="dPl8A78eQMizmNCE5-BY-1">
