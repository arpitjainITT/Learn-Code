        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\n!theme plain\n\nskinparam usecase {\n    BackgroundColor&lt;&lt;Main&gt;&gt; LightBlue\n    BackgroundColor&lt;&lt;Auth&gt;&gt; LightGreen\n    BackgroundColor&lt;&lt;News&gt;&gt; LightYellow\n    BackgroundColor&lt;&lt;Admin&gt;&gt; LightPink\n    BackgroundColor&lt;&lt;Notification&gt;&gt; LightCyan\n}\n\nleft to right direction\n\n&#39; === Actors on the left ===\nactor \&quot;Admin\&quot; as admin\nactor \&quot;User\&quot; as user\n\n&#39; === Right-side actors at top ===\nactor \&quot;System\&quot; as system\nactor \&quot;External APIs\&quot; as api\n\n&#39; === Use Case Rectangles ===\n\nrectangle \&quot;Authentication System\&quot; as AuthSys {\n    usecase \&quot;Login\&quot; as UC1 &lt;&lt;Auth&gt;&gt;\n    usecase \&quot;Sign Up\&quot; as UC2 &lt;&lt;Auth&gt;&gt;\n    usecase \&quot;Validate Email\&quot; as UC3 &lt;&lt;Auth&gt;&gt;\n    usecase \&quot;Validate Password\&quot; as UC4 &lt;&lt;Auth&gt;&gt;\n    usecase \&quot;Validate Username\&quot; as UC5 &lt;&lt;Auth&gt;&gt;\n    usecase \&quot;Check User Existence\&quot; as UC6 &lt;&lt;Auth&gt;&gt;\n    usecase \&quot;Logout\&quot; as UC7 &lt;&lt;Auth&gt;&gt;\n}\n\nrectangle \&quot;News Management System\&quot; as NewsSys {\n    usecase \&quot;View Today&#39;s Headlines\&quot; as UC8 &lt;&lt;News&gt;&gt;\n    usecase \&quot;View Headlines by Date Range\&quot; as UC9 &lt;&lt;News&gt;&gt;\n    usecase \&quot;View Headlines by Category\&quot; as UC10 &lt;&lt;News&gt;&gt;\n    usecase \&quot;Search Articles\&quot; as UC11 &lt;&lt;News&gt;&gt;\n    usecase \&quot;Save Article\&quot; as UC12 &lt;&lt;News&gt;&gt;\n    usecase \&quot;View Saved Articles\&quot; as UC13 &lt;&lt;News&gt;&gt;\n    usecase \&quot;Delete Saved Article\&quot; as UC14 &lt;&lt;News&gt;&gt;\n    usecase \&quot;Like Article\&quot; as UC15 &lt;&lt;News&gt;&gt;\n    usecase \&quot;Dislike Article\&quot; as UC16 &lt;&lt;News&gt;&gt;\n    usecase \&quot;Sort Articles by Likes/Dislikes\&quot; as UC17 &lt;&lt;News&gt;&gt;\n}\n\nrectangle \&quot;Admin Management System\&quot; as AdminSys {\n    usecase \&quot;View External Servers List\&quot; as UC18 &lt;&lt;Admin&gt;&gt;\n    usecase \&quot;View Server Details\&quot; as UC19 &lt;&lt;Admin&gt;&gt;\n    usecase \&quot;Update Server API Key\&quot; as UC20 &lt;&lt;Admin&gt;&gt;\n    usecase \&quot;Update Server Status\&quot; as UC21 &lt;&lt;Admin&gt;&gt;\n    usecase \&quot;Add News Category\&quot; as UC22 &lt;&lt;Admin&gt;&gt;\n    usecase \&quot;Monitor Server Status\&quot; as UC23 &lt;&lt;Admin&gt;&gt;\n}\n\nrectangle \&quot;Notification System\&quot; as NotifSys {\n    usecase \&quot;View Notifications\&quot; as UC24 &lt;&lt;Notification&gt;&gt;\n    usecase \&quot;Configure Category Notifications\&quot; as UC25 &lt;&lt;Notification&gt;&gt;\n    usecase \&quot;Configure Keyword Notifications\&quot; as UC26 &lt;&lt;Notification&gt;&gt;\n    usecase \&quot;Receive Email Notifications\&quot; as UC27 &lt;&lt;Notification&gt;&gt;\n    usecase \&quot;Mark Notifications as Read\&quot; as UC28 &lt;&lt;Notification&gt;&gt;\n    usecase \&quot;Set Notification Preferences\&quot; as UC29 &lt;&lt;Notification&gt;&gt;\n}\n\nrectangle \&quot;System Functions\&quot; as SysFuncs {\n    usecase \&quot;Fetch News from APIs\&quot; as UC30 &lt;&lt;Main&gt;&gt;\n    usecase \&quot;Store Articles in Database\&quot; as UC31 &lt;&lt;Main&gt;&gt;\n    usecase \&quot;Categorize Articles\&quot; as UC32 &lt;&lt;Main&gt;&gt;\n    usecase \&quot;Send Email Notifications\&quot; as UC33 &lt;&lt;Main&gt;&gt;\n    usecase \&quot;Handle Duplicate Articles\&quot; as UC34 &lt;&lt;Main&gt;&gt;\n    usecase \&quot;Schedule News Fetching\&quot; as UC35 &lt;&lt;Main&gt;&gt;\n}\n\n&#39; === Actor Relationships ===\n\nadmin --&gt; UC1\nadmin --&gt; UC7\nadmin --&gt; UC18\nadmin --&gt; UC19\nadmin --&gt; UC20\nadmin --&gt; UC21\nadmin --&gt; UC22\nadmin --&gt; UC23\n\nuser --&gt; UC1\nuser --&gt; UC2\nuser --&gt; UC7\nuser --&gt; UC8\nuser --&gt; UC9\nuser --&gt; UC10\nuser --&gt; UC11\nuser --&gt; UC12\nuser --&gt; UC13\nuser --&gt; UC14\nuser --&gt; UC15\nuser --&gt; UC16\nuser --&gt; UC24\nuser --&gt; UC25\nuser --&gt; UC26\nuser --&gt; UC28\nuser --&gt; UC29\n\nsystem --&gt; UC3\nsystem --&gt; UC4\nsystem --&gt; UC5\nsystem --&gt; UC6\nsystem --&gt; UC17\nsystem --&gt; UC30\nsystem --&gt; UC31\nsystem --&gt; UC32\nsystem --&gt; UC33\nsystem --&gt; UC34\nsystem --&gt; UC35\n\napi --&gt; UC30\n\n&#39; === Include Relationships ===\nUC2 ..&gt; UC3 : &lt;&lt;include&gt;&gt;\nUC2 ..&gt; UC4 : &lt;&lt;include&gt;&gt;\nUC2 ..&gt; UC5 : &lt;&lt;include&gt;&gt;\nUC2 ..&gt; UC6 : &lt;&lt;include&gt;&gt;\nUC1 ..&gt; UC6 : &lt;&lt;include&gt;&gt;\nUC11 ..&gt; UC17 : &lt;&lt;include&gt;&gt;\nUC9 ..&gt; UC10 : &lt;&lt;include&gt;&gt;\nUC25 ..&gt; UC29 : &lt;&lt;include&gt;&gt;\nUC26 ..&gt; UC29 : &lt;&lt;include&gt;&gt;\nUC30 ..&gt; UC31 : &lt;&lt;include&gt;&gt;\nUC30 ..&gt; UC32 : &lt;&lt;include&gt;&gt;\nUC30 ..&gt; UC34 : &lt;&lt;include&gt;&gt;\nUC35 ..&gt; UC30 : &lt;&lt;include&gt;&gt;\n\n&#39; === Extend Relationships ===\nUC8 &lt;.. UC10 : &lt;&lt;extend&gt;&gt;\nUC9 &lt;.. UC10 : &lt;&lt;extend&gt;&gt;\nUC24 &lt;.. UC27 : &lt;&lt;extend&gt;&gt;\nUC25 &lt;.. UC27 : &lt;&lt;extend&gt;&gt;\nUC26 &lt;.. UC27 : &lt;&lt;extend&gt;&gt;\nUC12 &lt;.. UC13 : &lt;&lt;extend&gt;&gt;\nUC14 &lt;.. UC13 : &lt;&lt;extend&gt;&gt;\n\n&#39; === Generalization ===\nUC18 &lt;|-- UC19 : &lt;&lt;generalize&gt;&gt;\nUC20 &lt;|-- UC21 : &lt;&lt;generalize&gt;&gt;\n\n&#39; === Notes ===\nnote right of UC2 : \&quot;Default role: User\&quot;\nnote right of UC30 : \&quot;Every 3-4 hours\&quot;\nnote right of UC32 : \&quot;Based on keywords in article content\&quot;\nnote right of UC27 : \&quot;Email + In-app notifications\&quot;\nnote right of UC34 : \&quot;Handle duplicates from multiple APIs\&quot;\nnote right of UC17 : \&quot;Sort by likes/dislikes count\&quot;\n\n@enduml\n&quot;,&quot;format&quot;:&quot;svg&quot;}" id="u4GyZ_zgJE4At1IwKbQj-1">
