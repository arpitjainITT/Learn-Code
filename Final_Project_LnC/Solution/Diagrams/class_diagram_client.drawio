<mxfile host="app.diagrams.net" agent="Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/138.0.0.0 Safari/537.36" version="27.2.0">
  <diagram name="Page-1" id="fhLgMI9XZOoq5Ud6orzC">
    <mxGraphModel dx="21690" dy="12500" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="850" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <UserObject label="" plantUmlData="{&quot;data&quot;:&quot;@startuml\n\n&#39; === Core ===\nclass App {\n    +run()\n    #showHomeMenu()\n    #handleLogin()\n    #handleSignup()\n    #showAdminMenu(user : User)\n    #showUserMenu(user : User)\n    #promptUserIdFromAuth(email : string, password : string) : int\n}\n\n&#39; === Models ===\nclass User {\n    -id : int\n    -role : string\n    -email : string\n    +User()\n    +getId() : int\n    +getRole() : string\n    +getEmail() : string\n    +setId(userId : int)\n    +setRole(r : string)\n    +setEmail(e : string)\n}\n\nclass Article &lt;&lt; (S,orchid) &gt;&gt; {\n    +id : int\n    +title : string\n    +description : string\n    +category : string\n    +source : string\n    +url : string\n    +createdAt : string\n    +Article()\n    +Article(id, title, description, category, source, url, createdAt)\n}\n\nclass Notification &lt;&lt; (S,orchid) &gt;&gt; {\n    +id : int\n    +title : string\n    +message : string\n    +category : string\n    +url : string\n    +source : string\n    +read : bool\n    +Notification(id, title, message, category, url, source, read)\n}\n\n&#39; === Services ===\nclass AuthService {\n    +login(email : string, password : string, user : User&amp;) : bool\n    +signup(username : string, email : string, password : string) : bool\n}\n\nclass NewsService {\n    +getArticles(category : string, startDate : string, endDate : string) : vector&lt;Article&gt;\n    +searchArticles(keyword : string, startDate : string, endDate : string, sortBy : string) : vector&lt;Article&gt;\n    +saveArticle(userId : int, articleId : int)\n    +likeArticle(userId : int, articleId : int)\n    +dislikeArticle(userId : int, articleId : int)\n}\n\nclass NotificationService {\n    +setCategoryPreference(userId : int, category : string, enabled : bool)\n    +setKeywordPreference(userId : int, keyword : string, enabled : bool)\n    +getPreferences(userId : int) : NotificationPreferences\n    +getNotifications(userId : int) : vector&lt;Notification&gt;\n    +markNotificationAsRead(notificationId : int)\n}\n\nclass NotificationPreferences &lt;&lt; (S,orchid) &gt;&gt; {\n    +categories : unordered_map&lt;string, bool&gt;\n    +keywords : unordered_map&lt;string, bool&gt;\n}\n\nclass SavedArticleService {\n    +getSavedArticles(userId : int) : vector&lt;Article&gt;\n    +deleteSavedArticle(userId : int, articleId : int)\n}\n\nclass AdminService {\n    +getAllServers() : vector&lt;ExternalServer&gt;\n    +getServerDetails(id : int) : ExternalServer\n    +updateServerApiKey(id : int, newKey : string)\n    +updateServerStatus(id : int, newStatus : string)\n    +addCategory(categoryName : string)\n}\n\nclass ExternalServer &lt;&lt; (S,orchid) &gt;&gt; {\n    +id : int\n    +name : string\n    +status : string\n    +lastAccessed : string\n    +apiKey : string\n}\n\n&#39; === UI ===\nabstract class BaseMenu {\n    +show() : void\n    +~BaseMenu()\n}\n\nclass LoginMenu {\n    +show()\n}\nBaseMenu &lt;|-- LoginMenu\n\nclass UserMenu {\n    +UserMenu(user : User)\n    +display()\n    -currentUser : User\n    -showHeadlinesMenu()\n    -showSavedArticlesMenu()\n    -showSearchMenu()\n    -showNotificationMenu()\n}\n\nclass AdminMenu {\n    +AdminMenu(user : User)\n    +display()\n    -currentUser : User\n    -listExternalServers()\n    -viewServerDetails()\n    -updateServerKey()\n    -updateServerStatus()\n    -addCategory()\n}\n\nclass HeadlinesMenu {\n    +HeadlinesMenu(user : User)\n    +display()\n    -currentUser : User\n    -showTodayMenu()\n    -showDateRangeMenu()\n    -fetchAndDisplayArticles(category : string, startDate : string, endDate : string)\n    -showArticleOptions(articleId : int)\n}\n\nclass SavedArticlesMenu {\n    +SavedArticlesMenu(user : User)\n    +display()\n    -currentUser : User\n    -listSavedArticles()\n    -deleteArticle(articleId : int)\n}\n\nclass NotificationMenu {\n    +NotificationMenu(user : User)\n    +display()\n    -currentUser : User\n    -viewDeliveredNotifications()\n    -viewPreferences()\n    -configureCategory()\n    -configureKeyword()\n}\n\nclass SearchMenu {\n    +SearchMenu(user : User)\n    +display()\n    -currentUser : User\n    -performSearch()\n}\n\n&#39; === Utils ===\nclass HttpClient {\n    +setAuthToken(token : string)\n    +get(endpoint : string) : string\n    +post(endpoint : string, body : string) : string\n    +put(endpoint : string, body : string) : string\n    +deleteRequest(endpoint : string) : string\n}\n\nclass ConsoleUtils {\n    +clear()\n    +getValidatedInput(min : int, max : int) : int\n    +pause()\n}\n\nclass Validator {\n    +isValidEmail(email : string) : bool\n    +isValidPassword(password : string) : bool\n    +isValidUsername(username : string) : bool\n}\n\nclass Paginator&lt;T&gt; {\n    -items : vector&lt;T&gt;&amp;\n    -currentPage : size_t\n    -pageSize : size_t\n    +Paginator(items : vector&lt;T&gt;&amp;, pageSize : size_t)\n    +display()\n}\n\n&#39; === Constants ===\nclass Strings\nclass APIEndpoints\n\n&#39; === Cross-folder Relationships ===\nApp ..&gt; User\nApp ..&gt; AuthService\nApp ..&gt; UserMenu\nApp ..&gt; AdminMenu\n\nAuthService ..&gt; User\nNewsService ..&gt; Article\nNotificationService ..&gt; Notification\nSavedArticleService ..&gt; Article\n\nAuthService ..&gt; HttpClient\nNewsService ..&gt; HttpClient\nNotificationService ..&gt; HttpClient\nSavedArticleService ..&gt; HttpClient\nAdminService ..&gt; HttpClient\n\nAuthService ..&gt; APIEndpoints\nNewsService ..&gt; APIEndpoints\nNotificationService ..&gt; APIEndpoints\nSavedArticleService ..&gt; APIEndpoints\nAdminService ..&gt; APIEndpoints\n\nUserMenu ..&gt; User\nAdminMenu ..&gt; User\nHeadlinesMenu ..&gt; User\nSavedArticlesMenu ..&gt; User\nNotificationMenu ..&gt; User\nSearchMenu ..&gt; User\n\nUserMenu ..&gt; NewsService\nUserMenu ..&gt; SavedArticleService\nUserMenu ..&gt; NotificationService\nAdminMenu ..&gt; AdminService\nHeadlinesMenu ..&gt; NewsService\nSavedArticlesMenu ..&gt; SavedArticleService\nNotificationMenu ..&gt; NotificationService\nSearchMenu ..&gt; NewsService\n\nUserMenu ..&gt; ConsoleUtils\nAdminMenu ..&gt; ConsoleUtils\nHeadlinesMenu ..&gt; ConsoleUtils\nSavedArticlesMenu ..&gt; ConsoleUtils\nNotificationMenu ..&gt; ConsoleUtils\nSearchMenu ..&gt; ConsoleUtils\n\nUserMenu ..&gt; Strings\nAdminMenu ..&gt; Strings\nHeadlinesMenu ..&gt; Strings\nSavedArticlesMenu ..&gt; Strings\nNotificationMenu ..&gt; Strings\nSearchMenu ..&gt; Strings\n\nHttpClient ..&gt; Strings\n\nNewsService ..&gt; Paginator\nSavedArticleService ..&gt; Paginator\nNotificationService ..&gt; Paginator\n\n@enduml\n&quot;,&quot;format&quot;:&quot;svg&quot;}" id="WfqoMq7fmqYS-peprUUh-2">
          <mxCell style="shape=image;noLabel=1;verticalAlign=top;aspect=fixed;imageAspect=0;image=data:image/svg+xml,;" vertex="1" parent="1">
            <mxGeometry x="-690" y="-240" width="3735" height="1004" as="geometry" />
          </mxCell>
        </UserObject>
      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
